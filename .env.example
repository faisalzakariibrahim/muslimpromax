# Client-safe public values (bundled into the app — these are meant to be public).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Used by eas.json / app.config.ts only
EAS_PROJECT_ID=

# NEVER put these in the client. Set them as Supabase Edge Function secrets:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# SUPABASE_SERVICE_ROLE_KEY is injected into functions automatically.
